{
  "name": "changemaker",
  "version": "0.1.0",
  "description": "Daily dev-update generator for public Gitea activity.",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "changemaker": "./dist/cli.js",
    "changemaker-server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('dist/src', 'dist', { recursive: true })\" && vite build",
    "build:web": "tsc -p web/tsconfig.json && vite build",
    "dev:web": "vite --host 0.0.0.0",
    "lint": "eslint .",
    "server": "node dist/server.js",
    "preview:web": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "format": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.0.14",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "openai": "^6.39.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  }
}

# Copy to .env for local Switchyard development.
# Never commit .env.
# Values here are safe examples; replace tokens/passwords before exposing services.

# Project / Compose profile
PROJECT_NAME=switchyard
# Set by release automation so images and containers can be traced to a commit.
SWITCHYARD_SOURCE_REVISION=unknown

# Local Postgres and published ports
POSTGRES_DB=switchyard
POSTGRES_USER=switchyard
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_PORT=5432
API_PORT=18080
WEB_PORT=8081
SWITCHYARD_BIND_HOST=127.0.0.1
# Optional separate web bind address. Keep the control API and Postgres on
# SWITCHYARD_BIND_HOST when exposing the web UI through an authenticated proxy.
SWITCHYARD_WEB_BIND_HOST=127.0.0.1
# Optional separate bind address for model-compatible ingress. Keep the control
# API and Postgres on SWITCHYARD_BIND_HOST when exposing this to a LAN.
SWITCHYARD_MODEL_BIND_HOST=127.0.0.1
# LLAMA_LINE_PORT serves llama-line/Ollama-compatible ingress during cutover:
# /broker/status, /v1/chat/completions, /api/chat, /api/generate, /api/tags,
# /v1/models, /api/embed, and /v1/embeddings. Admin and durable compatibility
# routes remain on the authenticated control API at API_PORT.
LLAMA_LINE_PORT=11434

# Switchyard API / operator safety
SWITCHYARD_PUBLIC_URL=
SWITCHYARD_REVERSE_PROXY_AUTH=false
SWITCHYARD_CONTROL_API_TOKEN=replace-with-a-long-random-secret
SWITCHYARD_CONTROL_READ_TOKEN=
SWITCHYARD_CORS_ALLOWED_ORIGINS=
SWITCHYARD_API_URL=http://127.0.0.1:28080
SWITCHYARD_DASHBOARD_CIDR=127.0.0.1/32

# OpenTelemetry / Phoenix tracing (OTLP/HTTP).
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=x-project-name=switchyard
OTEL_SERVICE_NAME=switchyard
OTEL_EXPORTER_OTLP_TRACES_PATH=/v1/traces
OTEL_EXPORTER_OTLP_TIMEOUT=10000

# Scheduler and async worker pool
SWITCHYARD_SCHEDULER_ENABLED=true
SWITCHYARD_SCHEDULER_INTERVAL=1m
SWITCHYARD_SCHEDULER_TIMEZONE=UTC
SWITCHYARD_WORKER_ENABLED=true
SWITCHYARD_WORKER_COUNT=1
SWITCHYARD_WORKER_LEASE=5m
SWITCHYARD_WORKER_POLL_INTERVAL=1s
SWITCHYARD_RUN_MAX_ATTEMPTS=3
SWITCHYARD_RUN_RETRY_BACKOFF=5s
SWITCHYARD_RUN_RETRY_MAX_BACKOFF=5m
SWITCHYARD_RUN_TIMEOUT=10m
SWITCHYARD_SHUTDOWN_GRACE=30s
SWITCHYARD_RETENTION=720h
SWITCHYARD_RETENTION_INTERVAL=24h
SWITCHYARD_MAX_REQUEST_BYTES=1048576
SWITCHYARD_MAX_PROMPT_BYTES=65536
SWITCHYARD_MAX_MODEL_RESPONSE_BYTES=1048576
SWITCHYARD_MAX_ARTIFACT_BYTES=1048576
SWITCHYARD_RATE_LIMIT_PER_SECOND=50
SWITCHYARD_HTTP_ALLOWED_HOSTS=
SWITCHYARD_HTTP_ALLOW_INSECURE=false
SWITCHYARD_HTTP_TIMEOUT=15s
SWITCHYARD_EXECUTOR_LIMITS=

# Native model broker and compatibility ingress.
# Deprecated external backend selector (ingress remains supported): llama-line.
# MODEL_BROKER_BACKEND=llama-line
# LLAMA_LINE_BASE_URL=http://llama-line:11434
# LLAMA_LINE_API_KEY=
MODEL_BROKER_TIMEOUT=10m
MODEL_BROKER_QUEUE_MAX_DEPTH=100
MODEL_BROKER_QUEUE_WORKERS=1
# Model broker reliability knobs. Keep retry attempts low for interactive clients.
# MODEL_BROKER_RETRY_ATTEMPTS=1
# MODEL_BROKER_RETRY_BACKOFF=250ms
MODEL_BROKER_RECOVERY_STALE_AFTER=15m
# Optional llama-line-compatible client key mapping for broker attribution and priority.
# Format: client-name=bearer-token:priority,other-client=other-token:priority
# MODEL_BROKER_CLIENT_KEYS=subcorp=replace-me:50
# Optional priorities for trusted header-identified clients without bearer keys.
# MODEL_BROKER_CLIENT_PRIORITIES=subcorp=50,ci=10
# Optional upstream Ollama. Do not point this at Switchyard's own LLAMA_LINE_PORT;
# it must be the real Ollama server behind the compatibility ingress.
OLLAMA_BASE_URL=
MODEL_BROKER_OLLAMA_MODELS=llama,qwen,mistral,codellama,nomic-embed,bge,deepseek,gemma,phi,hermes
# Optional comma-separated model list used by `switchyard models pull` when --models is omitted.
OLLAMA_PULL_MODELS=

# Native OpenCode executor.
# Set OPENCODE_WORKSPACE to one dedicated host checkout shared by API and
# OpenCode. Do not mount a parent directory containing unrelated repositories
# or credentials. The OpenCode container can only write this mounted path.
OPENCODE_EXECUTOR_TIMEOUT=10m
OPENCODE_SESSION_CREATE_TIMEOUT=5s
OPENCODE_MESSAGE_TIMEOUT=10m
OPENCODE_ABORT_TIMEOUT=1s
OPENCODE_SESSION_CREATE_TIMEOUT_MS=5000
OPENCODE_MESSAGE_TIMEOUT_MS=600000
OPENCODE_SERVER_URL=http://opencode:4096
OPENCODE_SERVER_USERNAME=switchyard
OPENCODE_SERVER_PASSWORD=opencode-change-me
OPENCODE_WORKSPACE=.
OPENCODE_CONFIG_DIR=./.opencode
OPENCODE_DATA_DIR=./opencode-data
# The OpenCode server starts as this unprivileged host identity after a brief
# state-volume bootstrap. Keep it aligned with the owner of OPENCODE_WORKSPACE.
# For a production worktree, use a dedicated non-root UID/GID and ownership.
OPENCODE_RUNTIME_UID=1000
OPENCODE_RUNTIME_GID=1000
# `strict` prevents a persistent config directory from restoring previous
# permissive plugins, permissions, or MCPs. Use `development` only for local
# experimentation after reviewing the mounted config; never use it in prod.
OPENCODE_SECURITY_MODE=strict
# Managed defaults disable remote/local MCP services, automatic updates, and
# session sharing. In development mode, add a reviewed MCP definition to
# OPENCODE_CONFIG_DIR only for a workflow that needs it; do not use floating
# @latest package specifiers.
# Historical compatibility fallback for the native OpenCode executor.
OCQ_DEFAULT_DIRECTORY=/workspace
# Deprecated external executor selector (ingress remains supported): ocq.
# OPENCODE_EXECUTOR_BACKEND=ocq
# OCQ_BASE_URL=http://ocq:8080
# OCQ_GATEWAY_KEY=

# Optional external adapters
BLACKTOWER_BASE_URL=
# Retained only for the external Changemaker adapter health probe; execution is native.
# CHANGEMAKER_BASE_URL=http://changemaker:8080
# CHANGEMAKER_ADMIN_TOKEN=

# Workflow models
DEVLOG_MODEL=gpt-5.4
OPEN_PILOT_MODEL=gpt-5.4
DEVLOG_ALLOWED_MODELS=gpt-5.4
OPEN_PILOT_ALLOWED_MODELS=gpt-5.4

# Gitea API and Git auth
# GITEA_GIT_USERNAME defaults to oauth2 for token-backed HTTPS git pushes.
GITEA_BASE_URL=
GITEA_TOKEN=
GITEA_GIT_USERNAME=oauth2

# Open Pilot issue policy and lifecycle gates
OPEN_PILOT_AUTONOMY_MODE=manual
OPEN_PILOT_COMMAND=
OPEN_PILOT_REQUIRED_LABELS=ready-for-agent,agent:queued
OPEN_PILOT_REQUIRE_ISSUE_SPEC=false
OPEN_PILOT_CI_CHECK_MODE=disabled
OPEN_PILOT_MERGE_MODE=disabled
OPEN_PILOT_CLOSE_ISSUE_MODE=disabled
OPEN_PILOT_REQUIRED_CHECKS=verify,lint,test
OPEN_PILOT_CI_CHECK_TIMEOUT=10m
OPEN_PILOT_CI_CHECK_INTERVAL=15s
OPEN_PILOT_PR_DRAFT=true

# Open Pilot git handoff
OPEN_PILOT_GIT_PUSH_MODE=disabled
OPEN_PILOT_AUTO_COMMIT_MODE=disabled
OPEN_PILOT_GITEA_WRITE_MODE=disabled
OPEN_PILOT_BASE_BRANCH=main
OPEN_PILOT_BRANCH_PREFIX=open-pilot/

# Open Pilot command policy
OPEN_PILOT_COMMAND_POLICY_MODE=deny
OPEN_PILOT_ALLOWED_COMMANDS=
OPEN_PILOT_ALLOWED_GIT_VERBS=
OPEN_PILOT_DENIED_COMMANDS=
OPEN_PILOT_COMMAND_TIMEOUT=120s
OPEN_PILOT_WORKDIR=

# Open Pilot isolated worktrees
OPEN_PILOT_WORKTREE_MODE=disabled
OPEN_PILOT_WORKTREE_CLEANUP=disabled
OPEN_PILOT_REPO_PATH=
OPEN_PILOT_WORKTREE_ROOT=
OPEN_PILOT_WORKTREE_TIMEOUT=120s

# PostgreSQL backup automation. The destination must be outside the repository
# and Docker volume and protected by the approved host encryption/access policy.
SWITCHYARD_BACKUP_DIR=
# Optional Prometheus node-exporter textfile path for backup freshness.
SWITCHYARD_BACKUP_METRICS_FILE=

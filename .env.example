# Copy to .env for local Switchyard development.
# Never commit .env.

PROJECT_NAME=switchyard

# Optional local Postgres profile used by docker-compose.yml.
POSTGRES_DB=switchyard
POSTGRES_USER=switchyard
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=18080
WEB_PORT=8081

# Optional: when set, Switchyard probes llama-line /broker/status for live queue/upstream state.
LLAMA_LINE_BASE_URL=
LLAMA_LINE_API_KEY=
LLAMA_LINE_ADMIN_KEY=

# Optional: when set, Switchyard probes OCQ health and session state.
OCQ_BASE_URL=
OCQ_GATEWAY_KEY=

# Optional: when set, Switchyard probes Blacktower control-center snapshots.
BLACKTOWER_BASE_URL=

# Optional: when set, Switchyard probes Changemaker health, posts, and run status.
CHANGEMAKER_BASE_URL=
CHANGEMAKER_ADMIN_TOKEN=

# Optional: in-process Switchyard trigger scheduler.
SWITCHYARD_SCHEDULER_ENABLED=false
SWITCHYARD_SCHEDULER_INTERVAL=1m

# Optional: enables the Open Pilot executor. Switchyard calls:
# $OPEN_PILOT_COMMAND run --repo <repo> --issue <issue> --json
OPEN_PILOT_COMMAND=

# Optional: model used by the Devlog workflow when llama-line or OCQ is configured.
DEVLOG_MODEL=opencode:gpt-5.5

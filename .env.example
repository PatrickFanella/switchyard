# Copy to .env for local Switchyard development.
# Never commit .env.
# Values here are safe examples; replace tokens/passwords before exposing services.

# Project / Compose profile
PROJECT_NAME=switchyard
# Set by release automation so images and containers can be traced to a commit.
SWITCHYARD_SOURCE_REVISION=unknown
SWITCHYARD_DEPLOYMENT_ID=
SWITCHYARD_COMPATIBILITY_OBSERVER_ENABLED=true

# Local Postgres and published ports
POSTGRES_DB=switchyard
POSTGRES_USER=switchyard
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_PORT=5432
API_PORT=18080
SWITCHYARD_LISTEN_ADDR=:8080
WEB_PORT=8081
SWITCHYARD_BIND_HOST=127.0.0.1
# Optional separate web bind address. Keep the control API and Postgres on
# SWITCHYARD_BIND_HOST when exposing the web UI through an authenticated proxy.
SWITCHYARD_WEB_TRANSPORT=http
SWITCHYARD_WEB_BIND_HOST=127.0.0.1
# Production requires host-managed Tailscale transport. Set the web bind to this
# host's 100.64.0.0/10 address and the proxy IPv4 to the other peer. Direct
# Tailscale traffic reaches nginx with that original peer address.
SWITCHYARD_TAILSCALE_PROXY_IPV4=
SWITCHYARD_DOCKER_BRIDGE_NAME=switchyard0
SWITCHYARD_DOCKER_BRIDGE_SUBNET=172.31.250.0/24
SWITCHYARD_DOCKER_BRIDGE_GATEWAY=172.31.250.1
SWITCHYARD_API_CONTAINER_IPV4=172.31.250.4
SWITCHYARD_WEB_CONTAINER_IPV4=172.31.250.10
SWITCHYARD_WEB_TRUSTED_PROXY_CIDR=100.77.128.80/32
# Optional separate bind address for model-compatible ingress. Keep the control
# API and Postgres on SWITCHYARD_BIND_HOST when exposing this to a LAN.
SWITCHYARD_MODEL_BIND_HOST=127.0.0.1
# LLAMA_LINE_PORT serves llama-line/Ollama-compatible ingress during cutover:
# /broker/status, /v1/chat/completions, /v1/completions, /v1/embeddings,
# /v1/models, /api/chat, /api/generate, /api/embed, /api/embeddings, and
# /api/tags. Health, readiness, and metrics are also available. Admin and durable compatibility
# routes remain on the authenticated control API at API_PORT.
LLAMA_LINE_PORT=11434
# Compose deliberately enables the second listener. A bare API process leaves it
# disabled unless this variable is set.
LLAMA_LINE_LISTEN_ADDR=:11434

# Dedicated webhook ingress. Disabled and unpublished by default. When enabled,
# bind a third loopback listener (for example, 127.0.0.1:8082) and mount both an
# owner-private config file and an owner-only 0700 secret directory. Secret files
# must be regular, owner-owned, mode 0400 files.
SWITCHYARD_WEBHOOK_LISTEN_ADDR=
SWITCHYARD_WEBHOOK_CONFIG_FILE=
SWITCHYARD_WEBHOOK_SECRET_DIR=
# Admission deadline. Must leave at least 1s below the server's 10s write deadline.
SWITCHYARD_WEBHOOK_TIMEOUT=5s
SWITCHYARD_WEBHOOK_MAX_CONCURRENCY=32
SWITCHYARD_WEBHOOK_RATE_LIMIT_PER_SECOND=20

# Switchyard API / operator safety
SWITCHYARD_PUBLIC_URL=
SWITCHYARD_REVERSE_PROXY_AUTH=false
SWITCHYARD_REVERSE_PROXY_TOKEN=replace-with-at-least-32-random-bytes
SWITCHYARD_CONTROL_API_TOKEN=replace-with-a-long-random-secret
SWITCHYARD_CONTROL_READ_TOKEN=
SWITCHYARD_CORS_ALLOWED_ORIGINS=
SWITCHYARD_API_URL=http://127.0.0.1:18080
SWITCHYARD_DASHBOARD_CIDR=127.0.0.1/32

# OpenTelemetry / Phoenix tracing (OTLP/HTTP).
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=x-project-name=switchyard
OTEL_SERVICE_NAME=switchyard
OTEL_EXPORTER_OTLP_TRACES_PATH=/v1/traces
OTEL_EXPORTER_OTLP_TIMEOUT=10000
# Optional operator trace UI used for run-cockpit trace links. Absolute http(s)
# URL; may contain a literal {trace_id} placeholder, otherwise the trace ID is
# appended as a path segment. Leave empty to show trace IDs as copyable text.
SWITCHYARD_TRACE_UI_URL=

# Scheduler and async worker pool
SWITCHYARD_SCHEDULER_ENABLED=true
SWITCHYARD_SCHEDULER_INTERVAL=1m
SWITCHYARD_SCHEDULER_TIMEZONE=UTC
SWITCHYARD_WORKER_ENABLED=true
SWITCHYARD_WORKER_COUNT=1
SWITCHYARD_WORKER_LEASE=5m
SWITCHYARD_WORKER_POLL_INTERVAL=1s
SWITCHYARD_RUN_MAX_ATTEMPTS=3
SWITCHYARD_RUN_RETRY_BACKOFF=5s
SWITCHYARD_RUN_RETRY_MAX_BACKOFF=5m
SWITCHYARD_RUN_TIMEOUT=10m
SWITCHYARD_SHUTDOWN_GRACE=30s
SWITCHYARD_RETENTION=720h
SWITCHYARD_RETENTION_INTERVAL=24h
SWITCHYARD_MAX_REQUEST_BYTES=1048576
SWITCHYARD_MAX_PROMPT_BYTES=65536
SWITCHYARD_MAX_MODEL_RESPONSE_BYTES=1048576
SWITCHYARD_MAX_ARTIFACT_BYTES=1048576
SWITCHYARD_RATE_LIMIT_PER_SECOND=50
SWITCHYARD_HTTP_ALLOWED_HOSTS=
SWITCHYARD_HTTP_ALLOW_INSECURE=false
SWITCHYARD_HTTP_TIMEOUT=15s
SWITCHYARD_EXECUTOR_LIMITS=

# Native model broker and compatibility ingress.
# Deprecated external backend selector (ingress remains supported): llama-line.
# MODEL_BROKER_BACKEND=llama-line
# LLAMA_LINE_BASE_URL=http://llama-line:11434
# LLAMA_LINE_API_KEY=
MODEL_BROKER_TIMEOUT=10m
MODEL_BROKER_QUEUE_MAX_DEPTH=100
MODEL_BROKER_QUEUE_WORKERS=1
# Model broker reliability knobs. Keep retry attempts low for interactive clients.
MODEL_BROKER_RETRY_ATTEMPTS=1
MODEL_BROKER_RETRY_BACKOFF=250ms
MODEL_BROKER_RECOVERY_STALE_AFTER=15m
# Optional llama-line-compatible client key mapping for broker attribution and priority.
# Format: client-name=bearer-token:priority,other-client=other-token:priority
# MODEL_BROKER_CLIENT_KEYS=subcorp=replace-me:50
# Optional priorities for trusted header-identified clients without bearer keys.
# MODEL_BROKER_CLIENT_PRIORITIES=subcorp=50,ci=10
# Optional in development. Tailscale production requires the exact bridge-gateway
# endpoint http://SWITCHYARD_DOCKER_BRIDGE_GATEWAY:11435.
OLLAMA_BASE_URL=
MODEL_BROKER_OLLAMA_MODELS=llama,qwen,mistral,codellama,nomic-embed,bge,deepseek,gemma,phi,hermes
# Optional comma-separated model list used by `switchyard models pull` when --models is omitted.
OLLAMA_PULL_MODELS=

# Native OpenCode executor.
# The ignored local default is prepared by `make workspace-init`. Production
# must override it with an existing absolute dedicated Git top-level outside
# this repository, owned by OPENCODE_RUNTIME_UID:OPENCODE_RUNTIME_GID and with a
# non-symlink `.git` directory. Never use a parent containing unrelated
# repositories or credentials. Preparation creates a private marker in
# `.open-pilot-worktrees`; production validation requires it.
OPENCODE_EXECUTOR_TIMEOUT=10m
OPENCODE_SESSION_CREATE_TIMEOUT=5s
OPENCODE_MESSAGE_TIMEOUT=10m
OPENCODE_ABORT_TIMEOUT=1s
OPENCODE_SESSION_CREATE_TIMEOUT_MS=5000
OPENCODE_MESSAGE_TIMEOUT_MS=600000
OPENCODE_SERVER_URL=http://opencode:4096
OPENCODE_SERVER_USERNAME=switchyard
OPENCODE_SERVER_PASSWORD=opencode-change-me
OPENCODE_WORKSPACE=./tmp/opencode-workspace
# Production requires canonical existing dedicated absolute directories outside
# this repository and OPENCODE_WORKSPACE, pre-owned by the runtime UID/GID with
# owner rwx and no group/world write. The entrypoint never recursively chowns them.
OPENCODE_CONFIG_DIR=./.opencode
OPENCODE_DATA_DIR=./opencode-data
# The OpenCode server starts as this unprivileged host identity after a brief
# state-volume bootstrap. Keep it aligned with the owner of OPENCODE_WORKSPACE.
# For a production worktree, use a dedicated non-root UID/GID and ownership.
OPENCODE_RUNTIME_UID=1000
OPENCODE_RUNTIME_GID=1000
# `strict` prevents a persistent config directory from restoring previous
# permissive plugins, permissions, or MCPs. Use `development` only for local
# experimentation after reviewing the mounted config; never use it in prod.
OPENCODE_SECURITY_MODE=strict
# Strict mode keeps account/session state in memory. Restarting OpenCode drops
# its session DB; Switchyard creates replacement sessions as work resumes.
OPENCODE_DB=:memory:
# Strict default. Set false only for explicit local development that needs
# project-level opencode.json or .opencode discovery.
OPENCODE_DISABLE_PROJECT_CONFIG=true
# Disable compatibility discovery of ~/.claude/CLAUDE.md in strict mode.
OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=true
# Managed defaults disable remote/local MCP services, automatic updates, and
# session sharing. In development mode, add a reviewed MCP definition to
# OPENCODE_CONFIG_DIR only for a workflow that needs it; do not use floating
# @latest package specifiers.
# Verifier requests are concurrency-, output-, and snapshot-bounded. Increase
# these only when trusted dependency-free checks need more temporary capacity.
SWITCHYARD_VERIFIER_CONCURRENCY=1
SWITCHYARD_VERIFIER_OUTPUT_BYTES=1048576
SWITCHYARD_VERIFIER_SNAPSHOT_MAX_FILES=10000
SWITCHYARD_VERIFIER_SNAPSHOT_MAX_BYTES=268435456
# Historical compatibility fallback for the native OpenCode executor.
OCQ_DEFAULT_DIRECTORY=/workspace/.open-pilot-worktrees
# Deprecated external executor selector (ingress remains supported): ocq.
# OPENCODE_EXECUTOR_BACKEND=ocq
# OCQ_BASE_URL=http://ocq:8080
# OCQ_GATEWAY_KEY=

# Optional external adapters
BLACKTOWER_BASE_URL=
# Retained only for the external Changemaker adapter health probe; execution is native.
# CHANGEMAKER_BASE_URL=http://changemaker:8080
# CHANGEMAKER_ADMIN_TOKEN=

# Workflow models
DEVLOG_MODEL=gpt-5.4
OPEN_PILOT_MODEL=gpt-5.4
DEVLOG_ALLOWED_MODELS=gpt-5.4
OPEN_PILOT_ALLOWED_MODELS=gpt-5.4
# Extra owner/repo slugs Devlog may read for repository evidence, in addition
# to the Open Pilot repository registry. Run inputs cannot widen this list.
DEVLOG_ALLOWED_REPOS=

# Gitea API and Git auth
# GITEA_GIT_USERNAME defaults to oauth2 for token-backed HTTPS git pushes.
GITEA_BASE_URL=
GITEA_TOKEN=
GITEA_GIT_USERNAME=oauth2
# Set these to the bot account name and verified email for attributed commits.
OPEN_PILOT_GIT_AUTHOR_NAME=Switchyard Open Pilot
OPEN_PILOT_GIT_AUTHOR_EMAIL=open-pilot@switchyard.local

# Open Pilot issue policy and lifecycle gates
OPEN_PILOT_AUTONOMY_MODE=manual
OPEN_PILOT_COMMAND=
OPEN_PILOT_REQUIRED_LABELS=ready-for-agent,agent:queued
# Optional alternative to the required labels: assign an issue to this Gitea login.
# Set to open-pilot to enable assignment-based pickup. Empty preserves label-only pickup.
OPEN_PILOT_ASSIGNEE=
OPEN_PILOT_POLL_REPOS=
OPEN_PILOT_REQUIRE_ISSUE_SPEC=false
OPEN_PILOT_CI_CHECK_MODE=disabled
OPEN_PILOT_CI_AUTO_REPAIR_MODE=disabled
OPEN_PILOT_MERGE_MODE=disabled
OPEN_PILOT_CLOSE_ISSUE_MODE=disabled
OPEN_PILOT_REQUIRED_CHECKS=verify,lint,test
OPEN_PILOT_CI_CHECK_TIMEOUT=10m
OPEN_PILOT_CI_CHECK_INTERVAL=15s
OPEN_PILOT_PR_DRAFT=true

# Open Pilot git handoff
OPEN_PILOT_GIT_PUSH_MODE=disabled
# Test-only escape hatch for local absolute/file:// bare remotes. Production
# validation rejects this; normal API push/remote checks require a matching
# sanitized HTTPS GITEA_BASE_URL origin even when GITEA_TOKEN is absent.
OPEN_PILOT_ALLOW_LOCAL_GIT_REMOTE=false
OPEN_PILOT_AUTO_COMMIT_MODE=disabled
OPEN_PILOT_GITEA_WRITE_MODE=disabled
OPEN_PILOT_BASE_BRANCH=main
OPEN_PILOT_BRANCH_PREFIX=open-pilot/

# Open Pilot command policy
OPEN_PILOT_COMMAND_POLICY_MODE=deny
OPEN_PILOT_ALLOWED_COMMANDS=git,go,make,pnpm,npm,cargo
OPEN_PILOT_ALLOWED_GIT_VERBS=status,diff,checkout,switch,branch,add,commit
OPEN_PILOT_DENIED_COMMANDS=rm,sudo,curl,wget,ssh,scp,docker,chmod,chown,dd,mkfs,bash,sh,zsh,fish
OPEN_PILOT_COMMAND_TIMEOUT=120s
OPEN_PILOT_WORKDIR=

# Open Pilot isolated worktrees
OPEN_PILOT_WORKTREE_MODE=disabled
OPEN_PILOT_WORKTREE_CLEANUP=disabled
# Keep these canonical container paths in production. The API receives the full
# workspace; OpenCode/verifier receive `.git` read-only plus the managed
# worktree subtree at read-write/read-only modes respectively.
OPEN_PILOT_REPO_PATH=/workspace
OPEN_PILOT_WORKTREE_ROOT=/workspace/.open-pilot-worktrees
SWITCHYARD_OPEN_PILOT_RUNTIME_MANIFEST=
# `disabled` loads and health-checks generated per-repository bundles without
# admitting work. `durable` delegates proof/allow and claim fencing to the
# database gate. `legacy-singleton` retains the Phase 1 compatibility path.
SWITCHYARD_OPEN_PILOT_ACTIVATION_MODE=legacy-singleton
# Phase 2 operator inputs and generated deployment documents. Use absolute,
# private, non-symlink paths in production. Rendering does not enable routing.
SWITCHYARD_OPEN_PILOT_OPERATOR_REGISTRY=
SWITCHYARD_OPEN_PILOT_COMPOSE_OVERRIDE=
SWITCHYARD_OPEN_PILOT_COMPOSE_FILE_SET=
OPEN_PILOT_EXECUTOR_GENERATION=legacy
# Exact owner/repo from OPEN_PILOT_REPO_PATH's origin. Set in production.
OPEN_PILOT_SINGLETON_REPOSITORY=
OPEN_PILOT_WORKTREE_TIMEOUT=120s

# PostgreSQL backup automation. The destination must be outside the repository
# and Docker volume and protected by the approved host encryption/access policy.
SWITCHYARD_BACKUP_DIR=
# Required immutable non-secret policy. Validate it against
# docs/persistence/operator-policy-v1.schema.json before backup installation.
SWITCHYARD_BACKUP_POLICY=
# Optional Prometheus textfile path and dedicated containing directory for
# backup freshness. Compose mounts only the directory read-only into the API,
# so the backup's atomic file replacement remains visible without a container
# restart. Keep the directory separate from backup archives, and make the file
# path `${SWITCHYARD_BACKUP_METRICS_DIR}/backup.prom`. Run one successful
# backup before starting Compose with non-empty paths.
SWITCHYARD_BACKUP_METRICS_DIR=
SWITCHYARD_BACKUP_METRICS_FILE=

# Manual disposable restore drill. The bundle is the manifest-last
# *.complete.json file, not the dump. Keep evidence in a private dedicated
# directory outside both the repository and backup directory.
SWITCHYARD_RESTORE_BUNDLE=
SWITCHYARD_RESTORE_ACTIVE_POLICY=
SWITCHYARD_RESTORE_EVIDENCE_DIR=
SWITCHYARD_RESTORE_TIMEOUT_SECONDS=900

# Opt-in scheduled restore drills. No cadence default exists; the validated
# policy's drill_calendar controls the timer. These canonical directories must
# be owner-only, non-symlinked, mutually separate, and outside the repository.
# The backup metrics directory remains the single read-only Compose mount.
SWITCHYARD_RESTORE_POLICY=
SWITCHYARD_RESTORE_DRILL_EVIDENCE_DIR=
SWITCHYARD_RESTORE_DRILL_METRICS_FILE=
SWITCHYARD_INSTALL_RESTORE_DRILL_TIMER=0

# Manual Alertmanager-to-ntfy lifecycle test. The harness is inert unless the
# opt-in is exactly 1. Use HTTPS URLs in real environments. The local-test
# override accepts HTTP only on localhost or a loopback address.
SWITCHYARD_ALERT_LIFECYCLE_TEST=0
SWITCHYARD_ALERTMANAGER_URL=
SWITCHYARD_NTFY_TOPIC_URL=
SWITCHYARD_ALERT_RECEIVER=
SWITCHYARD_ALERT_LIFECYCLE_TIMEOUT=120
SWITCHYARD_ALERT_LIFECYCLE_POLL_INTERVAL=2
SWITCHYARD_ALERT_LIFECYCLE_EVIDENCE_PATH=
SWITCHYARD_ALERT_LIFECYCLE_ALLOW_LOCAL_TEST=0
# Optional dedicated credentials. Choose bearer or a complete basic pair for
# each service. Do not put credentials in either URL.
SWITCHYARD_ALERTMANAGER_BEARER_TOKEN=
SWITCHYARD_ALERTMANAGER_BASIC_USERNAME=
SWITCHYARD_ALERTMANAGER_BASIC_PASSWORD=
SWITCHYARD_NTFY_BEARER_TOKEN=
SWITCHYARD_NTFY_BASIC_USERNAME=
SWITCHYARD_NTFY_BASIC_PASSWORD=

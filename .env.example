# Copy to .env for local Switchyard development.
# Never commit .env.

PROJECT_NAME=switchyard

# Optional local Postgres profile used by docker-compose.yml.
POSTGRES_DB=switchyard
POSTGRES_USER=switchyard
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=18080
WEB_PORT=8081
OCQ_PORT=8088
LLAMA_LINE_PORT=21434

# Built-in local llama-line service. Override only when using an external broker.
LLAMA_LINE_BASE_URL=http://llama-line:11434
LLAMA_LINE_API_KEY=switchyard-local-llama-line-key
LLAMA_LINE_ADMIN_KEY=switchyard-local-admin-key
MODEL_BROKER_TIMEOUT=10m

# Built-in local OCQ gateway. Override only when using an external gateway.
OCQ_BASE_URL=http://ocq:8088
OCQ_GATEWAY_KEY=switchyard-local-ocq-key
OPENCODE_EXECUTOR_TIMEOUT=10m
# Built-in local OpenCode server. OCQ forwards prompts here by default.
# Override OPENCODE_SERVER_URL to http://host.docker.internal:4096 to use a host-run server.
OPENCODE_SERVER_URL=http://opencode:4096
OPENCODE_SERVER_USERNAME=switchyard
OPENCODE_SERVER_PASSWORD=switchyard-local-opencode-password
OPENCODE_WORKSPACE=.
# Mount your real OpenCode config here when the container should use existing provider auth.
# Default config/data paths stay inside repo-local ignored directories. Set these to
# your host OpenCode paths to reuse `opencode auth login` credentials.
OPENCODE_CONFIG_DIR=./.opencode
OPENCODE_DATA_DIR=./opencode-data
OCQ_DEFAULT_DIRECTORY=/workspace

# Optional: when set, Switchyard probes Blacktower control-center snapshots.
BLACKTOWER_BASE_URL=

# Optional: when set, Switchyard probes Changemaker health, posts, and run status.
CHANGEMAKER_BASE_URL=
CHANGEMAKER_ADMIN_TOKEN=

# Public URL/auth boundary metadata. Set reverse-proxy auth true only after Caddy/Authelia/Cloudflare Access protects Switchyard.
SWITCHYARD_PUBLIC_URL=
SWITCHYARD_REVERSE_PROXY_AUTH=false

# Optional: in-process Switchyard trigger scheduler.
SWITCHYARD_SCHEDULER_ENABLED=false
SWITCHYARD_SCHEDULER_INTERVAL=1m

# Optional: async worker pool for long-running workflow execution.
SWITCHYARD_WORKER_ENABLED=false
SWITCHYARD_WORKER_COUNT=1
SWITCHYARD_WORKER_LEASE=5m
SWITCHYARD_WORKER_POLL_INTERVAL=1s
# Optional: comma-separated executor concurrency caps for pipeline steps.
# Example: model=1,opencode=1,command=2,git=1,gitea=2,http=2
SWITCHYARD_EXECUTOR_LIMITS=

# Optional: enables the Open Pilot executor. Switchyard calls:
# $OPEN_PILOT_COMMAND run --repo <repo> --issue <issue> --json
OPEN_PILOT_AUTONOMY_MODE=manual
OPEN_PILOT_COMMAND=

# Optional: model used by the Devlog workflow when llama-line or OCQ is configured.
DEVLOG_MODEL=gpt-5.4
OPEN_PILOT_MODEL=gpt-5.4
DEVLOG_ALLOWED_MODELS=gpt-5.4
OPEN_PILOT_ALLOWED_MODELS=gpt-5.4

# Optional: Open Pilot issue fetch/validation.
GITEA_BASE_URL=
GITEA_TOKEN=
OPEN_PILOT_REQUIRED_LABELS=ready-for-agent,agent:queued
OPEN_PILOT_REQUIRE_ISSUE_SPEC=false
OPEN_PILOT_CI_CHECK_MODE=disabled
OPEN_PILOT_MERGE_MODE=disabled
OPEN_PILOT_CLOSE_ISSUE_MODE=disabled
OPEN_PILOT_REQUIRED_CHECKS=verify,lint,test
OPEN_PILOT_CI_CHECK_TIMEOUT=10m
OPEN_PILOT_CI_CHECK_INTERVAL=15s
OPEN_PILOT_GIT_PUSH_MODE=disabled
OPEN_PILOT_GITEA_WRITE_MODE=disabled
OPEN_PILOT_BASE_BRANCH=main
OPEN_PILOT_BRANCH_PREFIX=open-pilot/
OPEN_PILOT_PR_DRAFT=true

# Open Pilot command policy for branch/test automation. Default is deny.
OPEN_PILOT_COMMAND_POLICY_MODE=deny
OPEN_PILOT_ALLOWED_COMMANDS=git,go,make,pnpm,npm,cargo
OPEN_PILOT_ALLOWED_GIT_VERBS=status,diff,checkout,switch,branch,add,commit
OPEN_PILOT_DENIED_COMMANDS=rm,sudo,curl,wget,ssh,scp,docker,chmod,chown,dd,mkfs,bash,sh,zsh,fish
OPEN_PILOT_COMMAND_TIMEOUT=120s
OPEN_PILOT_WORKDIR=

# Optional: isolated git worktree creation for Open Pilot branch/test runs.
# disabled/dry-run only attach branch plans; allow runs `git worktree add -b`.
OPEN_PILOT_WORKTREE_MODE=disabled
OPEN_PILOT_WORKTREE_CLEANUP=disabled
OPEN_PILOT_REPO_PATH=
OPEN_PILOT_WORKTREE_ROOT=
OPEN_PILOT_WORKTREE_TIMEOUT=120s

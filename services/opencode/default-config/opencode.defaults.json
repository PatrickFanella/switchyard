{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "/home/opencode/.config/opencode/plugins/rtk.ts",
    "/home/opencode/.config/opencode/plugins/switchyard-blacktower.ts",
    "/home/opencode/.config/opencode/plugins/extraction.ts"
  ],
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true }
  },
  "skills": {
    "paths": [
      "/home/opencode/.config/opencode/skills"
    ]
  },
  "share": "disabled",
  "autoupdate": false,
  "lsp": true,
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "bash": "deny",
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "question": "deny"
  },
  "compaction": {
    "auto": false,
    "reserved": 10000
  },
  "experimental": {
    "mcp_timeout": 30000
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  }
}

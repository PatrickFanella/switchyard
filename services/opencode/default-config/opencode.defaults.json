{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "/home/opencode/.config/opencode/plugins/rtk.ts",
    "/home/opencode/.config/opencode/plugins/switchyard-blacktower.ts"
  ],
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true }
  },
  "skills": {
    "paths": [
      "/home/opencode/.config/opencode/skills",
      "/home/opencode/.config/opencode/blacktower/managed-skills"
    ]
  },
  "share": "disabled",
  "autoupdate": false,
  "lsp": true,
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "bash": {
      "git *": "allow",
      "go *": "allow",
      "make *": "allow",
      "npm *": "allow",
      "node *": "allow",
      "pnpm *": "allow",
      "bun *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "cat *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "*": "ask"
    },
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "question": "deny"
  },
  "compaction": {
    "auto": false,
    "prune": true,
    "reserved": 10000
  },
  "experimental": {
    "mcp_timeout": 30000
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  }
}

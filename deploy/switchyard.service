[Unit]
Description=Switchyard automation runtime
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__REPO_ROOT__
ExecStartPre=/usr/bin/python3 __REPO_ROOT__/scripts/validate_production_config.py --env-file __REPO_ROOT__/.env
ExecStart=/usr/bin/docker compose --env-file __REPO_ROOT__/.env up -d --remove-orphans
ExecReload=/usr/bin/python3 __REPO_ROOT__/scripts/validate_production_config.py --env-file __REPO_ROOT__/.env
ExecReload=/usr/bin/docker compose --env-file __REPO_ROOT__/.env up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

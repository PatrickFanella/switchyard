[Unit]
Description=Switchyard automation runtime
Requires=docker.service switchyard-web-gate.service
After=docker.service switchyard-web-gate.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=__RUN_USER__
Group=__RUN_GROUP__
SupplementaryGroups=__DOCKER_GROUP__
WorkingDirectory=__REPO_ROOT__
ExecStartPre=+__REPO_ROOT__/deploy/switchyard-compose --env-file __ENV_FILE__ --file-set __COMPOSE_FILE_SET__ -- stop web
ExecStartPre=/usr/bin/python3 __REPO_ROOT__/scripts/validate_production_config.py --env-file __ENV_FILE__
ExecStartPre=/usr/bin/python3 __RENDERER__ --env-file __ENV_FILE__ --require-matching-output __NFT_RULES__
ExecStartPre=+/usr/bin/python3 __UFW_HELPER__ verify-gate --env-file __ENV_FILE__
ExecStart=__REPO_ROOT__/deploy/switchyard-compose --env-file __ENV_FILE__ --file-set __COMPOSE_FILE_SET__ -- up -d --remove-orphans
ExecReload=+__REPO_ROOT__/deploy/switchyard-compose --env-file __ENV_FILE__ --file-set __COMPOSE_FILE_SET__ -- stop web
ExecReload=/usr/bin/python3 __REPO_ROOT__/scripts/validate_production_config.py --env-file __ENV_FILE__
ExecReload=/usr/bin/python3 __RENDERER__ --env-file __ENV_FILE__ --require-matching-output __NFT_RULES__
ExecReload=+/usr/bin/python3 __UFW_HELPER__ verify-gate --env-file __ENV_FILE__
ExecReload=__REPO_ROOT__/deploy/switchyard-compose --env-file __ENV_FILE__ --file-set __COMPOSE_FILE_SET__ -- up -d --build --remove-orphans
ExecStop=__REPO_ROOT__/deploy/switchyard-compose --env-file __ENV_FILE__ --file-set __COMPOSE_FILE_SET__ -- stop
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

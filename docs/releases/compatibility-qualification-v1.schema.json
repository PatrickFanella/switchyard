{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compatibility-qualification-v1.schema.json",
  "title": "Switchyard compatibility zero-use release qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_tag",
    "release_sha",
    "qualified_at",
    "evidence_artifact",
    "evidence_raw_sha256",
    "manifest_artifact",
    "manifest_raw_sha256",
    "report_artifact",
    "report_raw_sha256",
    "report_canonical_sha256"
  ],
  "properties": {
    "schema_version": { "const": "switchyard.compatibility-qualification/v1" },
    "release_tag": { "type": "string", "pattern": "^v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "release_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "qualified_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "evidence_artifact": { "const": "deployed-evidence.json" },
    "evidence_raw_sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the exact evidence artifact bytes" },
    "manifest_artifact": { "const": "manifest.json" },
    "manifest_raw_sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the exact manifest artifact bytes" },
    "report_artifact": { "const": "compatibility-retirement-report.json" },
    "report_raw_sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the exact report artifact bytes" },
    "report_canonical_sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the canonical parsed report" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_basename": { "type": "string", "pattern": "^(?!\\.)[^/\\\\]+\\.json$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "switchyard.open-pilot-operator-registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generation",
    "repositories"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}/(?!\\.{1,2}$)[A-Za-z0-9._-]{1,100}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "aliases",
        "executor_generation",
        "source_path",
        "worktree_root",
        "config_path",
        "data_path",
        "password_file"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "aliases": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "executor_generation": {
          "$ref": "#/$defs/generation"
        },
        "source_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "worktree_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "config_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "data_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "password_file": {
          "$ref": "#/$defs/absolutePath"
        },
        "base_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "verifier_image": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "opencode_image": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}

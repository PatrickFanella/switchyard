{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "switchyard.completed-backup-bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "bundle_id", "completed_at", "archive", "metadata", "policy", "object_contract"],
  "properties": {
    "contract_version": {"const": "switchyard.completed-backup-bundle.v1"},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "completed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "archive": {"$ref": "#/$defs/file"},
    "metadata": {"$ref": "#/$defs/file"},
    "policy": {"$ref": "#/$defs/file"},
    "object_contract": {"$ref": "#/$defs/file"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basename", "sha256"],
      "properties": {
        "basename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
